# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nokepoints"

# Kick OAuth
KICK_CLIENT_ID="your_kick_client_id"
KICK_CLIENT_SECRET="your_kick_client_secret"
KICK_REDIRECT_URI="https://your-domain.com/api/auth/kick-callback"

# Session (generate a random string at least 32 chars)
SESSION_SECRET="generate-a-random-string-at-least-32-characters-long"

# App URL
NEXT_PUBLIC_APP_URL="https://your-domain.com"
